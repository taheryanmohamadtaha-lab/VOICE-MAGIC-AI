# Copy to .env (never commit .env). All values are optional.
VMA_DB_PATH=./data/voice_magic.db
# Credits granted to every new user, and cost of one conversion
VMA_FREE_CREDITS=10
VMA_CONVERT_COST=1
# Max upload size in megabytes
VMA_MAX_UPLOAD_MB=25
# Which AI provider adapter to use. "none" = no AI configured (default, honest).
VMA_AI_PROVIDER=none
